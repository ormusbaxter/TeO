{
  "name": "teo-team-employee-organizer",
  "version": "4.35.2",
  "private": true,
  "type": "module",
  "description": "Mitarbeiter- und Organisationsverwaltung für eine Intensivstation",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm run check && npm test",
    "release:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/New-ReleasePackage.ps1",
    "version:major": "node tools/bump-version.mjs major",
    "version:feature": "node tools/bump-version.mjs feature",
    "version:fix": "node tools/bump-version.mjs fix"
  },
  "engines": {
    "node": ">=20"
  }
}
